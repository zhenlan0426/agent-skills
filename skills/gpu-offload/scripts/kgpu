#!/usr/bin/env python3
"""Prepare, submit, monitor, and retrieve private Kaggle batch jobs (CLI 2.2.2)."""
import argparse
import base64
import fnmatch
import io
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys
import time
import uuid
import zipfile

EXCLUDED = {'.git', '.venv', 'venv', 'node_modules', '__pycache__', '.pytest_cache',
            '.mypy_cache', '.ipynb_checkpoints', '.kaggle', '.ssh', '.aws', '.cache',
            '.env', '.envrc', '.netrc', 'kaggle.json', 'access_token', 'credentials.json'}
# Live transport validation and failure evidence: references/kaggle-cli-notes.md.
COMPRESSED_LIMIT = 512 * 1024
SOURCE_LIMIT = 704 * 1024
UNPACKED_LIMIT = 20 * 1024 * 1024
ENVSETUP = Path(__file__).resolve().parent / 'envsetup'


def save(path, value):
    path.write_text(json.dumps(value, indent=2) + '\n')


def cli(*args, timeout=120, log_path=None):
    try:
        result = subprocess.run(['kaggle', *map(str, args)], capture_output=True,
                                text=True, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        if log_path is not None:
            # TimeoutExpired may carry bytes even with text=True.
            chunks = [v.decode('utf-8', errors='replace') if isinstance(v, bytes) else v or ''
                      for v in (exc.stdout, exc.stderr)]
            log_path.write_text(''.join(chunks) + '\nLocal CLI timeout; remote acceptance is unknown.\n')
        raise
    output = result.stdout + result.stderr
    if log_path is not None:
        log_path.write_text(output)
    if result.returncode:
        raise ValueError(f'Kaggle exited {result.returncode}:\n{output}')
    return output


def read_job(folder):
    path = Path(folder).resolve()
    return path, json.loads((path / 'job.json').read_text())


def bundle(project, excludes):
    git = subprocess.run(['git', '-C', str(project), 'rev-parse', '--show-toplevel'],
                         capture_output=True, text=True)
    if git.returncode == 0:
        listing = subprocess.run(['git', '-C', str(project), 'ls-files', '-z',
                                  '--cached', '--others', '--exclude-standard', '--', '.'],
                                 capture_output=True, check=True)
        names = sorted(set(os.fsdecode(listing.stdout).rstrip('\0').split('\0')))
    else:
        names = []
        for root, dirs, files in os.walk(project, followlinks=False):
            dirs[:] = [d for d in dirs if d not in EXCLUDED and not d.startswith('.env.')]
            names.extend(str((Path(root) / f).relative_to(project)) for f in files)
        names.sort()
    output, manifest, total = io.BytesIO(), [], 0
    with zipfile.ZipFile(output, 'w', zipfile.ZIP_DEFLATED) as archive:
        for name in names:
            if not name:
                continue
            rel = Path(name)
            if rel.is_absolute() or '..' in rel.parts:
                raise ValueError(f'Unsafe project path: {name}')
            if any(p in EXCLUDED or p.startswith('.env.') for p in rel.parts):
                continue
            if rel.suffix.lower() in {'.pem', '.key', '.p12', '.pfx'}:
                continue
            if any(fnmatch.fnmatchcase(name, pat) for pat in excludes):
                continue
            path = project / rel
            if any((project / Path(*rel.parts[:n])).is_symlink() for n in range(1, len(rel.parts) + 1)):
                continue
            if not path.is_file():
                continue
            size = path.stat().st_size
            total += size
            if total > UNPACKED_LIMIT:
                raise ValueError('Project exceeds 20 MiB. Exclude large files and attach a dataset.')
            archive.write(path, rel.as_posix())
            manifest.append({'path': rel.as_posix(), 'bytes': size})
    if not manifest:
        raise ValueError('No project files remain after exclusions.')
    data = output.getvalue()
    if len(data) > COMPRESSED_LIMIT:
        raise ValueError(f'Compressed project is {len(data):,} bytes; embedded limit is '
                         f'{COMPRESSED_LIMIT:,} bytes. Exclude large files or use a private '
                         'dataset with a small bootstrap (references/kaggle-data-and-runtime.md).')
    return base64.b64encode(data).decode(), manifest


def check_source_size(source):
    size = len(source)
    if size > SOURCE_LIMIT:
        raise ValueError(f'Kernel source is {size:,} bytes; tested embedded limit is '
                         f'{SOURCE_LIMIT:,} bytes including base64, wrapper, and command. '
                         'Reduce the embedded project/command or use a private dataset '
                         '(references/kaggle-data-and-runtime.md). No submission attempted.')
    return size


def runner(payload, command, run_id, gpu, setup=None):
    # Constants are emitted as Python literals, never interpolated into a shell.
    # `setup` is envsetup's source plus its install arguments; it runs before the
    # command, and a failed install fails the job without running the command.
    envsetup, setup_args = setup or (None, None)
    return f'''# Generated by kgpu. Project source is embedded below.
import base64, io, json, os, pathlib, subprocess, sys, time, zipfile
root = pathlib.Path('/kaggle/working')
project = root / 'project'
project.mkdir(parents=True, exist_ok=True)
with zipfile.ZipFile(io.BytesIO(base64.b64decode({payload!r}))) as archive:
    for member in archive.infolist():
        rel = pathlib.PurePosixPath(member.filename)
        if rel.is_absolute() or '..' in rel.parts:
            raise ValueError('Unsafe archive member')
        archive.extract(member, project)
        (project / member.filename).chmod((member.external_attr >> 16) & 0o777)
os.chdir(project)
os.environ['PYTHONUNBUFFERED'] = '1'
os.environ['KGPU_RUN_ID'] = {run_id!r}
os.environ['KGPU_OUTPUT_DIR'] = str(root / 'out')
(root / 'out').mkdir(exist_ok=True)
result = {{'run_id': {run_id!r}, 'argv': {command!r}, 'started': time.time(), 'exit_code': 1}}
try:
    print('KGPU run:', {run_id!r}, flush=True)
    if {gpu!r}:
        subprocess.run(['nvidia-smi'], check=True)
    if {setup_args!r} is not None:
        tool = pathlib.Path('/tmp/kgpu-envsetup')
        tool.write_text({envsetup!r})
        subprocess.run([sys.executable, str(tool), 'probe', '--json', str(root / 'out' / 'env.json')])
        result['setup_exit_code'] = subprocess.run(
            [sys.executable, str(tool), 'install', *{setup_args!r},
             '--report', str(root / 'out' / 'envsetup.json')]).returncode
    if result.get('setup_exit_code'):
        print('kgpu: environment setup failed; command not run', flush=True)
        result['exit_code'] = result['setup_exit_code']
    else:
        result['exit_code'] = subprocess.run({command!r}).returncode
finally:
    result['finished'] = time.time()
    (root / 'kgpu-result.json').write_text(json.dumps(result, indent=2))
if result['exit_code'] != 0:
    raise RuntimeError('Job failed with exit code ' + str(result['exit_code']))
'''


def prepare(args, command):
    if not command:
        raise ValueError('Provide the batch command after --, e.g. -- python -u train.py')
    if not re.fullmatch(r'[A-Za-z0-9_-]+', args.owner):
        raise ValueError('Supply a Kaggle username, not a URL.')
    project = Path(args.project).resolve(strict=True)
    target = Path(args.job).resolve()
    if not project.is_dir():
        raise ValueError('--project must be a directory.')
    if target == project or project in target.parents:
        raise ValueError('Prepare the job outside the project directory.')
    if target.exists():
        raise ValueError('Job directory already exists. Choose a fresh directory.')
    setup = None
    if args.setup is not None:
        setup_args = shlex.split(args.setup)
        if not args.internet and '--wheels' not in setup_args:
            raise ValueError('--setup installs packages: add --internet, or put wheels in a '
                             'dataset and pass --wheels /kaggle/input/... inside --setup.')
        setup = (ENVSETUP.read_text(), setup_args)
    payload, manifest = bundle(project, args.exclude)
    run_id = uuid.uuid4().hex
    slug = 'kgpu-' + time.strftime('%Y%m%d-%H%M%S', time.gmtime()) + '-' + run_id[:10]
    ref = args.owner + '/' + slug
    # TPU shapes are accelerators too, but have no nvidia-smi to probe.
    gpu = args.accelerator.startswith('Nvidia')
    metadata = dict(id=ref, title=slug, code_file='kernel.py', language='python',
                    kernel_type='script', is_private=True,
                    enable_gpu=gpu, enable_internet=args.internet,
                    dataset_sources=args.dataset, competition_sources=args.competition,
                    kernel_sources=args.kernel_source, model_sources=[])
    source = runner(payload, command, run_id, gpu, setup).encode('utf-8')
    source_bytes = check_source_size(source)
    sizes = dict(compressed_bytes=len(base64.b64decode(payload)), base64_bytes=len(payload),
                 unpacked_bytes=sum(f['bytes'] for f in manifest), source_bytes=source_bytes)
    target.mkdir(parents=True)
    (target / 'kernel.py').write_bytes(source)
    save(target / 'kernel-metadata.json', metadata)
    save(target / 'manifest.json', manifest)
    save(target / 'job.json', dict(ref=ref, run_id=run_id, accelerator=args.accelerator,
                                  run_timeout=args.run_timeout, command=command, sizes=sizes,
                                  setup=setup and setup[1]))
    print(f'Prepared {ref}\nCompressed project: {sizes["compressed_bytes"]:,} / '
          f'{COMPRESSED_LIMIT:,} bytes; kernel source: {source_bytes:,} / {SOURCE_LIMIT:,} bytes.'
          f'\nReview {target / "manifest.json"}\nNo files uploaded.')


def submit(args):
    path, job = read_job(args.job)
    metadata = json.loads((path / 'kernel-metadata.json').read_text())
    if (metadata.get('is_private') is not True or metadata.get('id') != job['ref']
            or metadata.get('id_no')):
        raise ValueError('Job metadata must retain its unique id and is_private=true.')
    if metadata.get('code_file') != 'kernel.py':
        raise ValueError('Job metadata must retain code_file=kernel.py.')
    # Recheck the actual file: old jobs and edits must not bypass the new ceiling.
    source_bytes = check_source_size((path / 'kernel.py').read_bytes())
    attempt = path / 'submission-attempt.json'
    # Exclusive create also prevents duplicate concurrent submissions.
    with attempt.open('x') as stream:
        json.dump({'ref': job['ref'], 'attempted_at': time.time(), 'source_bytes': source_bytes}, stream)
    print('Kernel URL: https://www.kaggle.com/code/' + job['ref'], flush=True)
    print('Submission recorded. If interrupted, check status before any retry.', flush=True)
    cmd = ['kernels', 'push', '-p', str(path), '--timeout', str(job['run_timeout'])]
    if job['accelerator'] != 'cpu':
        cmd += ['--accelerator', job['accelerator']]
    output = cli(*cmd, log_path=path / 'submission.log')
    print(output, end='')
    # CLI 2.2.2 omits the number when the response lacks one.
    match = re.search(r'Kernel version (?:(\d+) )?successfully pushed', output)
    if not match or 'Kernel push error:' in output:
        raise ValueError('Submission not confirmed. Inspect submission.log and remote status; do not retry blindly.')
    save(path / 'submitted.json', {'version': int(match[1]) if match[1] else None, 'submitted_at': time.time()})
    if 'not valid' in output.lower():
        raise ValueError('Kaggle accepted the run but rejected some sources/tags. Inspect the response.')


def status(job, timeout=120):
    output = cli('kernels', 'status', job['ref'], timeout=timeout)
    match = re.search(r'has status "([^"]+)"', output)
    if not match:
        raise ValueError('Unrecognized status response:\n' + output)
    return match[1].split('.')[-1].lower(), output


def readable_logs(output):
    """Kaggle can return a JSON event array instead of plain log text."""
    try:
        events = json.loads(output)
    except ValueError:
        return output
    if isinstance(events, list) and all(isinstance(e, dict) and isinstance(e.get('data'), str) for e in events):
        return ''.join(e['data'] for e in events)
    return output


def wait(args):
    _, job = read_job(args.job)
    deadline = time.monotonic() + args.timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            print('Local wait expired; remote job was not stopped.')
            return 124
        try:
            state, output = status(job, timeout=min(remaining, 120))
        except subprocess.TimeoutExpired:
            print('Local wait expired during status request; remote job was not stopped.')
            return 124
        print(output, end='', flush=True)
        if state == 'complete':
            return 0
        if state in {'error', 'cancelacknowledged', 'cancel_acknowledged', 'cancelled', 'canceled'}:
            return 1
        if state not in {'queued', 'running', 'cancelrequested', 'cancel_requested', 'new_script'}:
            raise ValueError(f'Unknown remote state: {state}')
        time.sleep(min(args.poll, max(0, deadline - time.monotonic())))


def pull(args):
    _, job = read_job(args.job)
    state, output = status(job)
    if state != 'complete' and not args.partial:
        raise ValueError(output + 'Use --partial to inspect available output from a failed/incomplete job.')
    target = Path(args.output).resolve()
    if target.exists() and (not target.is_dir() or any(target.iterdir())):
        raise ValueError('Output directory must be new or empty to avoid mixing runs.')
    target.mkdir(parents=True, exist_ok=True)
    print(cli('kernels', 'output', job['ref'], '-p', target, timeout=args.timeout), end='')
    marker = target / 'kgpu-result.json'
    if not marker.is_file():
        raise ValueError('No run marker downloaded; output completeness and job success are unverified.')
    result = json.loads(marker.read_text())
    if result.get('run_id') != job['run_id']:
        raise ValueError('Downloaded output belongs to another run.')
    if result.get('setup_exit_code'):
        raise ValueError(f'Environment setup failed (exit {result["setup_exit_code"]}); the command '
                         f'did not run. See {target}/out/envsetup.json and `kgpu logs`.')
    if result.get('exit_code') != 0:
        raise ValueError(f'Job failed (exit {result.get("exit_code")}); partial outputs retained in {target}')
    if state != 'complete':
        raise ValueError(f'Run marker succeeded, but remote status is {state}; do not claim completion yet.')
    print(f'Verified run {job["run_id"]}; results at {target}')


def positive(value):
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError('must be a positive integer')
    return number


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest='action', required=True)
    prep = subs.add_parser('prepare', help='package local code without uploading; command follows --')
    prep.add_argument('job')
    prep.add_argument('--project', required=True)
    prep.add_argument('--owner', required=True)
    prep.add_argument('--accelerator', required=True, help='exact Kaggle shape, e.g. NvidiaTeslaT4, or cpu')
    prep.add_argument('--run-timeout', type=positive, default=3600, help='remote runtime limit in seconds (default 3600)')
    prep.add_argument('--internet', action='store_true', help='enable network in the kernel')
    prep.add_argument('--setup', metavar="'ARGS'",
                      help="run `envsetup install ARGS` before the command, e.g. "
                           "--setup '-r requirements.txt --skip flash-attn'")
    for flag in ['dataset', 'competition', 'kernel-source', 'exclude']:
        prep.add_argument('--' + flag, action='append', default=[])
    for action in ['submit', 'status', 'logs', 'wait', 'pull']:
        p = subs.add_parser(action)
        p.add_argument('job')
        if action == 'logs':
            p.add_argument('-n', type=positive, default=80)
        if action == 'wait':
            p.add_argument('--timeout', type=positive, default=45)
            p.add_argument('--poll', type=positive, default=15)
        if action == 'pull':
            p.add_argument('output')
            p.add_argument('--partial', action='store_true')
            p.add_argument('--timeout', type=positive, default=1800, help='local download timeout in seconds')
    argv = sys.argv[1:]
    command = []
    if argv[:1] == ['prepare'] and '--' in argv:
        split = argv.index('--')
        argv, command = argv[:split], argv[split + 1:]
    args = parser.parse_args(argv)
    try:
        if args.action == 'prepare':
            prepare(args, command)
        elif args.action == 'submit':
            submit(args)
        elif args.action == 'wait':
            return wait(args)
        elif args.action == 'pull':
            pull(args)
        else:
            _, job = read_job(args.job)
            if args.action == 'status':
                print(status(job)[1], end='')
            else:
                print('\n'.join(readable_logs(cli('kernels', 'logs', job['ref'])).splitlines()[-args.n:]))
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        print(f'kgpu: {exc}', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
