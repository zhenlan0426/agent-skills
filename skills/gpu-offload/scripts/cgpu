#!/usr/bin/env python3
"""cgpu: run GPU jobs on Google Colab through the official `colab` CLI.

Wraps the patterns that were verified against colab-cli 0.7.4:
  * a job runs as a subprocess inside ONE blocking kernel cell, so the kernel
    stays busy (Colab keeps busy runtimes alive) and the job survives the local
    client disconnecting;
  * the local `colab exec` client is detached once the job has started (it
    busy-waits a full CPU core otherwise);
  * progress is read by downloading the VM-side log (the Contents API works
    while the kernel is busy; a second `colab exec` would queue behind the job).

Commands after `--` are an argv, run without a shell. For pipes, globs or `&&`,
say so explicitly: `-- bash -c 'pip list | grep torch'`.

Usage:
  cgpu up SESSION GPU [--high-mem]        GPU: T4 L4 G4 A100 H100 cpu
  cgpu push SESSION LOCAL [REMOTE]        file or dir (dirs are tarred); default /content/<basename>
  cgpu secrets SESSION [kaggle] [hf]      copy ~/.kaggle/kaggle.json / HF token onto the VM
  cgpu setup SESSION [-- ARGS]            fingerprint the VM, then `envsetup install ARGS`
                                          (paths are VM paths, e.g. -r /content/p/requirements.txt)
  cgpu start SESSION [--cwd DIR] -- CMD   start CMD as a background job (one per session)
  cgpu logs SESSION [-n N] [--full]       tail the current job's log
  cgpu wait SESSION [--poll S] [--timeout S]  block until the job ends; exits with
                                          its code, or 124 if --timeout runs out
  cgpu kill SESSION                       stop the job (SIGTERM, then SIGKILL if needed)
  cgpu pull SESSION REMOTE LOCAL          file: to LOCAL, or into it if LOCAL is a dir
                                          or ends in /; dir: its contents into LOCAL
  cgpu sh SESSION -- CMD                  run a short command (kernel must be idle)
  cgpu down SESSION                       stop the VM and print the compute-unit balance
  cgpu ls                                 sessions + compute-unit usage

Env: CGPU_AUTH (default oauth2) is passed as `colab --auth=...`;
     CGPU_START_WAIT (default 180) is how long `start` waits for the job to leave
     the kernel's queue.
"""
import argparse
import fcntl
import json
import os
import shlex
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid
from functools import partial
from pathlib import Path, PurePosixPath

print = partial(print, flush=True)  # keep ordering with colab's own output

AUTH = os.environ.get("CGPU_AUTH", "oauth2")
GPUS = {"T4", "L4", "G4", "A100", "H100"}
STATE_DIR = Path.home() / ".cache" / "cgpu"
REMOTE_ROOT = "/content/.cgpu"
ENVSETUP = Path(__file__).resolve().parent / "envsetup"
PUSH_EXCLUDED = {'.git', '.venv', 'venv', 'node_modules', '__pycache__', '.pytest_cache',
                 '.mypy_cache', '.ipynb_checkpoints', '.kaggle', '.ssh', '.aws', '.cache',
                 '.env', '.envrc', '.netrc', 'kaggle.json', 'access_token', 'credentials.json'}
PUSH_EXCLUDED_SUFFIXES = {'.pem', '.key', '.p12', '.pfx', '.pyc'}
# `colab exec --timeout` is a wall-clock budget; anything short kills the
# client (not the job) with a TimeoutError traceback and exit 1.
LONG = str(7 * 24 * 3600)
CHUNK = 40 * 1000 * 1000
# The job wrapper keeps the log's last TAIL_BYTES in a side file, so `logs`
# doesn't download a multi-GB log to show 40 lines of it.
TAIL_BYTES = 256 * 1024
# The job cell refreshes a heartbeat every 2s. One this old (by the local clock)
# means the cell is gone without writing status.json: kernel restarted or died.
BEAT_STALE = 180
START_WAIT = int(os.environ.get("CGPU_START_WAIT", 180))
TERM_GRACE = float(os.environ.get("CGPU_TERM_GRACE", 5))
KILL_WAIT = float(os.environ.get("CGPU_KILL_WAIT", 5))


def die(msg, code=1):
    print(f"cgpu: {msg}", file=sys.stderr)
    sys.exit(code)


def colab(*args, capture=False, check=True, stdin=None, **kw):
    cmd = ["colab", f"--auth={AUTH}", *args]
    r = subprocess.run(cmd, text=True, input=stdin,
                       capture_output=capture, **kw)
    if check and r.returncode != 0:
        if capture:
            sys.stderr.write(r.stdout + r.stderr)
        die(f"`{' '.join(cmd[:4])} ...` failed (exit {r.returncode})", r.returncode)
    return r


def exec_py(session, code, timeout="600", check=True):
    """Run Python in the kernel, stream its output, return an exit code.

    `colab exec` exits 0 even when the cell raises, so the cell reports its own
    status: it prints a per-call marker + `_cgpu_rc` (code may set it) as its
    last act; no marker means the cell died with an exception. Output need not
    end in a newline, so the marker is looked for anywhere in a line. Kernel
    must be idle.
    """
    require_idle(session, "this step")
    mark = f"__CGPU_RC_{uuid.uuid4().hex}__="
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as f:
        f.write(f"_cgpu_rc = 0\n{code}\nprint({mark!r} + str(_cgpu_rc))\n")
    try:
        p = subprocess.Popen(["colab", f"--auth={AUTH}", "exec", "-s", session,
                              "--timeout", timeout, "-f", f.name],
                             stdout=subprocess.PIPE, text=True)
        rc = 1
        for line in p.stdout:
            before, found, after = line.partition(mark)
            if found:
                if before:
                    sys.stdout.write(before + "\n")
                rc = int(after)
            else:
                sys.stdout.write(line)
        if p.wait() != 0:
            rc = p.returncode
    finally:
        os.unlink(f.name)
    if check and rc != 0:
        die(f"remote step failed (exit {rc})", rc)
    return rc


def download(session, remote, local):
    """`colab download`. Returns None on success, "missing" or "directory" for
    those two remote conditions, and dies on anything else."""
    r = colab("download", "-s", session, remote, str(local), capture=True, check=False)
    if r.returncode == 0:
        return None
    out = r.stdout + r.stderr
    # colab-cli 0.7.4 wording: "Download failed: File or directory not found:
    # PATH", "Download failed: Cannot download a directory: PATH", and for a
    # missing session "Session 'S' not found."
    if "File or directory not found" in out:
        return "missing"
    if "Cannot download a directory" in out:
        return "directory"
    sys.stderr.write(out)
    if f"Session '{session}' not found" in out:
        die(f"session '{session}' is gone (VM stopped or reclaimed); see `cgpu ls`", 3)
    die("download failed (session gone? try `cgpu ls`)", 3)


def download_text(session, remote):
    """Return the remote file's text, or None if it does not exist."""
    with tempfile.TemporaryDirectory() as d:
        local = os.path.join(d, "f")
        if download(session, remote, local) == "missing":
            return None
        return Path(local).read_text(errors="replace")


def upload_text(session, text, remote):
    with tempfile.NamedTemporaryFile("w", delete=False) as f:
        f.write(text)
    try:
        colab("upload", "-s", session, f.name, remote, capture=True)
    finally:
        os.unlink(f.name)


def job_file(session):
    return STATE_DIR / f"{session}.json"


def load_job(session):
    p = job_file(session)
    return json.loads(p.read_text()) if p.exists() else None


def save_job(session, job):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = job_file(session).with_suffix(".tmp")
    tmp.write_text(json.dumps(job))
    os.replace(tmp, job_file(session))


def current_job(session):
    job = load_job(session)
    if job is None:
        die(f"no job recorded for session '{session}' (start one with `cgpu start`)")
    return job


def session_lock(session):
    """Keep local up, start, push and down operations on one session ordered."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock = open(STATE_DIR / f"{session}.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        die(f"another `cgpu up/start/push/down` on '{session}' is in progress")
    return lock


def job_status(session, job):
    """The job's final status dict ({"rc": int, "error": str|None}), or None
    while it has not finished."""
    text = download_text(session, job["dir"] + "/status.json")
    return json.loads(text) if text is not None else None


def cancel_path(job):
    # In /tmp because the job's own dir may not exist yet, and an upload into
    # a missing directory is not something to rely on.
    return f"/tmp/cgpu-cancel-{job['id']}"


def job_state(session, job):
    """(kind, status): kind is "finished" (status is the dict), "running",
    "queued" (start never confirmed it left the kernel queue), "cancelled"
    (it never will: it aborts on arrival) or "lost" (its cell stopped without
    a status, e.g. a kernel restart; the process may still be running)."""
    st = job_status(session, job)
    if st is not None:
        return "finished", st
    if job.get("state") == "cancelled":
        return "cancelled", None
    beat = download_text(session, job["dir"] + "/beat")
    if beat is None:  # also records from before heartbeats existed
        return ("queued" if job.get("state") == "submitting" else "running"), None
    if time.time() - float(beat) > BEAT_STALE:
        return "lost", None
    return "running", None


def settle(session, job):
    """Resolve a job whose start was never confirmed. The cell writes `claim`
    and then checks for the cancel marker; here the marker is written and then
    `claim` checked. Whatever the interleaving, either we see the claim (the
    job ran or is running) or the cell sees the marker (it will never run the
    command). Returns the job's new state, "started" or "cancelled"."""
    upload_text(session, "cancelled by cgpu start\n", cancel_path(job))
    if (download_text(session, job["dir"] + "/claim") is not None
            or job_status(session, job) is not None):
        job["state"] = "started"
    else:
        job["state"] = "cancelled"
    save_job(session, job)
    return job["state"]


def lost_msg(session, job):
    return (f"job {job['id']} lost its kernel cell without recording an exit "
            "status (kernel restarted or crashed?). Its process group may still be "
            f"running and writing the log (`cgpu logs {session} --full`); "
            f"`cgpu kill {session}` stops it")


def require_idle(session, what):
    """Refuse kernel work while a job holds the kernel: `colab exec` would
    queue behind it, and the queued cell still runs after its client gives up."""
    job = load_job(session)
    if job is None:
        return
    kind, _ = job_state(session, job)
    if kind in ("running", "queued"):
        die(f"{what} needs an idle kernel, but job {job['id']} is {kind} on "
            f"'{session}'. Wait for it (`cgpu wait {session}`), use a second "
            "session, or pull single files, which work mid-job")


def excluded_push_path(rel):
    return any(part in PUSH_EXCLUDED or part.startswith('.env.')
               or Path(part).suffix.lower() in PUSH_EXCLUDED_SUFFIXES for part in rel.parts)


def project_files(src):
    """Files in a push archive, respecting Git ignore rules and secret filters."""
    git = subprocess.run(['git', '-C', str(src), 'rev-parse', '--show-toplevel'],
                         capture_output=True, text=True)
    if git.returncode == 0:
        listing = subprocess.run(['git', '-C', str(src), 'ls-files', '-z', '--cached',
                                  '--others', '--exclude-standard', '--', '.'],
                                 capture_output=True, check=True)
        names = sorted(set(os.fsdecode(listing.stdout).rstrip('\0').split('\0')))
    else:
        names = []
        for root, dirs, files in os.walk(src, followlinks=False):
            relroot = Path(root).relative_to(src)
            dirs[:] = [name for name in dirs
                       if not excluded_push_path(relroot / name)
                       and not (Path(root) / name).is_symlink()]
            names.extend((relroot / name).as_posix() for name in files)
        names.sort()

    files = []
    for name in names:
        if not name:
            continue
        rel = Path(name)
        if rel.is_absolute() or '..' in rel.parts or excluded_push_path(rel):
            continue
        path = src / rel
        if any((src / Path(*rel.parts[:n])).is_symlink()
               for n in range(1, len(rel.parts) + 1)):
            continue
        if path.is_file():
            files.append((path, rel))
    return files


# ---------------------------------------------------------------- commands

def cmd_up(a):
    gpu = a.gpu.upper()
    args = ["new", "-s", a.session]
    if gpu != "CPU":
        # colab-cli maps an unknown --gpu value to A100 silently; refuse instead.
        if gpu not in GPUS:
            die(f"unknown GPU '{a.gpu}'; choose from {sorted(GPUS)} or cpu")
        args += ["--gpu", gpu]
    if a.high_mem:
        args.append("--high-mem")
    lock = session_lock(a.session)  # noqa: F841 (held until exit)
    # `colab new` on a name in use allocates a second VM and repoints the name
    # at it, orphaning the first (still billed). `colab sessions` drops local
    # names whose VM is gone, so only a live one is listed.
    listing = colab("sessions", capture=True).stdout
    if any(line.startswith(f"[{a.session}] ") for line in listing.splitlines()):
        die(f"session '{a.session}' already exists. Use it as is, pick another "
            f"name, or replace it deliberately: `cgpu down {a.session}` first")
    r = colab(*args, capture=True, check=False)
    print(r.stdout, end="")
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        die(f"could not allocate {gpu}; it may be unavailable right now or not "
            "in this plan. Ask the user before trying a different GPU.", r.returncode)
    job_file(a.session).unlink(missing_ok=True)  # a fresh VM has no jobs
    exec_py(a.session, "import subprocess\nprint(subprocess.run(['nvidia-smi',"
            "'--query-gpu=name,memory.total','--format=csv,noheader'],"
            "capture_output=True,text=True).stdout or 'no GPU')", timeout="120")
    colab("usage")


def cmd_push(a):
    src = Path(a.local).expanduser().resolve()
    if not src.exists():
        die(f"{src} does not exist")
    dest = a.remote or f"/content/{src.name}"
    lock = session_lock(a.session)  # noqa: F841 (avoid racing local start/up/down)
    if src.is_file():
        if src.stat().st_size > CHUNK:
            require_idle(a.session, f"pushing large file {src}")
        upload(a.session, src, dest)
        return
    if not src.is_dir():
        die(f"{src} is not a regular file or directory")
    members = project_files(src)
    if not members:
        die("no project files remain after Git-ignore and credential exclusions")
    with tempfile.TemporaryDirectory() as d:
        tgz = Path(d) / "push.tgz"
        with tarfile.open(tgz, "w:gz") as t:
            for path, rel in members:
                t.add(path, arcname=rel.as_posix(), recursive=False)
        remote_tgz = f"/tmp/cgpu-push-{uuid.uuid4().hex[:8]}.tgz"
        require_idle(a.session, f"pushing directory {src}")
        try:
            upload(a.session, tgz, remote_tgz)
            exec_py(a.session, f"import os,tarfile\nos.makedirs({dest!r},exist_ok=True)\n"
                    f"tarfile.open({remote_tgz!r}).extractall({dest!r},filter='fully_trusted')\n"
                    f"print('extracted to', {dest!r})")
        finally:
            colab("rm", "-s", a.session, remote_tgz, capture=True, check=False)


def upload(session, local, remote):
    """`colab upload`, split into parts: the runtime proxy drops uploads
    somewhere between 50 and 100 MB (downloads have no such limit)."""
    size = local.stat().st_size
    print(f"[cgpu] uploading {local.name} ({size / 1e6:.1f} MB, ~7 MB/s) -> {remote}")
    if size <= CHUNK:
        colab("upload", "-s", session, str(local), remote, capture=True)
        return
    parts = []
    try:
        with open(local, "rb") as f, tempfile.TemporaryDirectory() as d:
            while chunk := f.read(CHUNK):
                part = Path(d) / "part"
                part.write_bytes(chunk)
                rpart = f"/tmp/cgpu-part-{uuid.uuid4().hex[:8]}"
                parts.append(rpart)
                colab("upload", "-s", session, str(part), rpart, capture=True)
                print(f"[cgpu]   {f.tell() / 1e6:.0f}/{size / 1e6:.0f} MB")
        exec_py(session, f"import os\nos.makedirs(os.path.dirname({remote!r}) or '.',"
                f"exist_ok=True)\nwith open({remote!r},'wb') as out:\n"
                f"    for p in {parts!r}:\n        out.write(open(p,'rb').read())")
    finally:
        for part in parts:
            colab("rm", "-s", session, part, capture=True, check=False)


def cmd_secrets(a):
    which = a.which or ["kaggle", "hf"]
    files = {"kaggle": (Path.home() / ".kaggle/kaggle.json", "/root/.kaggle/kaggle.json"),
             "hf": (Path(os.environ.get("HF_HOME", Path.home() / ".cache/huggingface"))
                    / "token", "/root/.cache/huggingface/token")}
    # Upload as files rather than `colab exec --env`: --env puts the value in
    # the local argv and in colab-cli's local history log.
    moves = []
    for w in which:
        if w not in files:
            die(f"unknown secret '{w}' (kaggle, hf)")
        local, remote = files[w]
        if not local.exists():
            die(f"{local} not found")
        tmp = f"/tmp/cgpu-secret-{uuid.uuid4().hex[:8]}"
        colab("upload", "-s", a.session, str(local), tmp, capture=True)
        moves.append((tmp, remote))
    exec_py(a.session, "import os,shutil\n" + "".join(
        f"os.makedirs(os.path.dirname({r!r}),exist_ok=True)\n"
        f"shutil.move({t!r},{r!r})\nos.chmod({r!r},0o600)\nprint('installed',{r!r})\n"
        for t, r in moves), timeout="120")


def cmd_setup(a):
    remote = "/tmp/cgpu-envsetup"  # uploads into a missing directory fail
    require_idle(a.session, "setup")
    colab("upload", "-s", a.session, str(ENVSETUP), remote, capture=True)
    steps = [["probe", "--json", f"{REMOTE_ROOT}/env.json"]]
    if a.cmd:
        steps.append(["install", *a.cmd, "--report", f"{REMOTE_ROOT}/envsetup.json"])
    # Stream line by line: a child's raw stdout bypasses the kernel's iopub
    # stream, and an install can run for minutes.
    code = ("import subprocess, sys\n"
            f"for step in {steps!r}:\n"
            f"    p = subprocess.Popen([sys.executable, {remote!r}, *step], "
            "stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\n"
            "    for line in p.stdout:\n        print(line, end='')\n"
            "    _cgpu_step_rc = p.wait()\n"
            "    if _cgpu_step_rc:\n        _cgpu_rc = _cgpu_step_rc\n        break\n")
    rc = exec_py(a.session, code, timeout=str(a.timeout), check=False)
    if rc:
        die(f"setup failed (exit {rc}); its reason is in the output above", rc)


def cmd_start(a):
    if not a.cmd:
        die("usage: cgpu start SESSION [--cwd DIR] -- CMD [ARGS...]")
    lock = session_lock(a.session)  # noqa: F841 (held until exit)
    prev = load_job(a.session)
    if prev:
        if prev.get("state") == "submitting":  # an earlier start never finished
            settle(a.session, prev)
        kind, _ = job_state(a.session, prev)
        if kind in ("running", "queued"):
            die(f"job {prev['id']} is still {kind} on '{a.session}' (one job per "
                f"session): `cgpu wait {a.session}` or `cgpu kill {a.session}` first")
        if kind == "lost" and not prev.get("killed"):
            die(lost_msg(a.session, prev) + "; then start again")
    command = shlex.join(a.cmd)
    jid = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:4]
    jdir = f"{REMOTE_ROOT}/{jid}"
    job = {"id": jid, "dir": jdir, "cmd": command, "cwd": a.cwd,
           "started": time.time(), "state": "submitting"}
    cancel = cancel_path(job)
    # Every outcome ends in status.json, launch failures (bad --cwd, missing
    # program) and cancellation included, so `wait` always has something to find.
    cell = f"""
import json, os, subprocess, threading, time

def _put(name, text):
    tmp = os.path.join({jdir!r}, '.' + name)
    with open(tmp, 'w') as f:
        f.write(text)
    os.replace(tmp, os.path.join({jdir!r}, name))

def _tail(log_path):
    try:
        with open(log_path, 'rb') as f:
            f.seek(max(0, os.path.getsize(log_path) - {TAIL_BYTES}))
            _put('tail', f.read().decode(errors='replace'))
        _put('beat', repr(time.time()))
    except OSError:
        pass

os.makedirs({jdir!r}, exist_ok=True)
_put('claim', '')  # before the cancel check: see settle() in cgpu
_put('beat', repr(time.time()))
log_path = os.path.join({jdir!r}, 'log')
status = {{'rc': None, 'error': None}}
with open(log_path, 'wb') as log:
    if os.path.exists({cancel!r}):
        status = {{'rc': 125, 'error': 'cancelled before it started: cgpu start gave up waiting'}}
        log.write((status['error'] + '\\n').encode())
    else:
      try:
        p = subprocess.Popen({list(a.cmd)!r}, cwd={a.cwd!r}, stdout=log,
                             stderr=subprocess.STDOUT, start_new_session=True,
                             env={{**os.environ, 'PYTHONUNBUFFERED': '1'}})
      except Exception as e:
        status = {{'rc': 127, 'error': f'could not launch: {{type(e).__name__}}: {{e}}'}}
        log.write((status['error'] + '\\n').encode())
      else:
        _put('pid', str(p.pid))
        done = threading.Event()
        def _tailer():
            while not done.wait(2):
                _tail(log_path)
        tailer = threading.Thread(target=_tailer, daemon=True)
        tailer.start()
        status['rc'] = p.wait()
        done.set()
        tailer.join()
_tail(log_path)
_put('status.json', json.dumps(status))
"""
    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as f:
        f.write(cell)
    client_log = STATE_DIR / f"{a.session}-{jid}.client.log"
    # Recorded before dispatch: from here on the cell may run whatever happens
    # to this process, and the next `start` settles a record left "submitting".
    save_job(a.session, job)
    with open(client_log, "w") as out:
        client = subprocess.Popen(
            ["colab", f"--auth={AUTH}", "exec", "-s", a.session,
             "--timeout", LONG, "-f", f.name],
            stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
    failure = None
    try:
        deadline = time.time() + START_WAIT
        while True:  # a claim or status proves the job left the kernel queue
            # Read the client's state before the VM's: a fast job may finish
            # (and its client exit 0) between two polls.
            exited = client.poll() is not None
            if (download_text(a.session, jdir + "/claim") is not None
                    or job_status(a.session, job) is not None):
                job["state"] = "started"
                save_job(a.session, job)
                break
            if exited:
                failure = (f"exec client exited before the job started (exit "
                           f"{client.returncode}); see {client_log}")
                break
            if time.time() >= deadline:
                failure = (f"job did not start within {START_WAIT}s (kernel busy?); "
                           f"see {client_log}")
                break
            time.sleep(2)
        client.terminate()  # the kernel cell keeps running without us
        if failure and settle(a.session, job) == "cancelled":
            die(failure + ". It was cancelled and will not run later")
    finally:
        os.unlink(f.name)
    st = job_status(a.session, job)
    if st and st["error"]:
        die(f"job {jid}: {st['error']}", st["rc"])
    print(f"[cgpu] job {jid} started on '{a.session}': {command}")
    print(f"[cgpu] follow with: cgpu logs {a.session}   |   cgpu wait {a.session}")


def cmd_logs(a):
    job = current_job(a.session)
    # The tail is missing only in a job's first ~2s, while the log is small.
    text = None if a.full else download_text(a.session, job["dir"] + "/tail")
    if text is not None:
        lines = text.replace("\r", "\n").splitlines()  # tqdm writes \r
        if len(text.encode()) >= TAIL_BYTES:
            lines = lines[1:]  # the tail starts mid-line
            if len(lines) < a.n:
                print(f"[cgpu] the log's last {TAIL_BYTES // 1024}KB hold only "
                      f"{len(lines)} complete lines; `--full` downloads the whole "
                      "log", file=sys.stderr)
    else:
        text = download_text(a.session, job["dir"] + "/log")
        lines = text.replace("\r", "\n").splitlines() if text is not None else []
    if lines:
        print("\n".join(lines[-a.n:]))
    kind, st = job_state(a.session, job)
    mins = (time.time() - job["started"]) / 60
    print(f"[cgpu] job {job['id']}: " + {
        "finished": lambda: f"FINISHED exit={st['rc']}"
                            + (f" ({st['error']})" if st["error"] else ""),
        "running": lambda: f"running ({mins:.0f} min)",
        "queued": lambda: "start not confirmed (queued behind other kernel work?)",
        "cancelled": lambda: "cancelled before it started",
        "lost": lambda: "LOST: " + lost_msg(a.session, job),
    }[kind](), file=sys.stderr)
    return kind, st


def cmd_wait(a):
    job = current_job(a.session)
    deadline = a.timeout and time.time() + a.timeout
    while (kind := job_state(a.session, job)[0]) in ("running", "queued"):
        if deadline and time.time() >= deadline:
            a.n, a.full = 20, False
            cmd_logs(a)
            die(f"job {job['id']} still {kind} after {a.timeout}s", 124)
        time.sleep(a.poll if not deadline else
                   max(0, min(a.poll, deadline - time.time())))
    a.n, a.full = 40, False
    kind, st = cmd_logs(a)
    if kind != "finished":
        die(f"job {job['id']} has no exit status ({kind})", 3)
    rc = st["rc"]
    sys.exit(128 - rc if rc < 0 else rc)  # killed by signal N -> 128+N


def signal_group(session, pid, sig):
    token = uuid.uuid4().hex
    marker = f"__CGPU_{sig}_{token}__"
    # The console echoes typed input, so the command must not contain the
    # marker verbatim: the shell joins the quoted halves only when it runs.
    command = f"if kill -{sig} -{pid}; then echo __CGPU_{sig}''_{token}__; fi\n"
    r = colab("console", "-s", session, stdin=command, capture=True,
              check=False, timeout=60)
    output = r.stdout + r.stderr
    return marker in output, output


def wait_for_status(session, job, timeout):
    deadline = time.monotonic() + timeout
    while True:
        status = job_status(session, job)
        if status is not None:
            return status
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        time.sleep(min(0.25, remaining))


def cmd_kill(a):
    job = current_job(a.session)
    kind, status = job_state(a.session, job)
    if kind == "finished":
        print(f"[cgpu] job {job['id']} already finished (exit={status['rc']})")
        return
    if kind == "cancelled":
        print(f"[cgpu] job {job['id']} was cancelled before it started")
        return
    pid = download_text(a.session, job["dir"] + "/pid")
    if pid is None:
        status = wait_for_status(a.session, job, 1)
        if status is not None:
            print(f"[cgpu] job {job['id']} already finished (exit={status['rc']})")
            return
        die("job has no pid file yet")
    pid = pid.strip()
    if not pid.isdigit():
        die(f"job pid file contains an invalid process id: {pid!r}")

    # A lost job (kernel restarted) never writes a status, and its process
    # may already be gone; either way the kill must be recorded so `start`
    # can proceed.
    status, step = None, "SIGTERM"
    sent, output = signal_group(a.session, pid, "TERM")
    if sent:
        status = wait_for_status(a.session, job, TERM_GRACE)
        if status is None:
            step = "SIGKILL"
            sent, output = signal_group(a.session, pid, "KILL")
            if sent:
                status = wait_for_status(a.session, job, KILL_WAIT)
    gone = not sent and "No such process" in output
    if not sent and not gone:
        die(f"could not send {step} to process group {pid}: {output.strip() or 'no confirmation'}")
    if gone:
        status = wait_for_status(a.session, job, 1)
    job["killed"] = True  # lets `start` proceed past a lost job
    save_job(a.session, job)
    if status is not None:
        how = f"finished before {step}" if gone else (
            "required SIGKILL" if step == "SIGKILL" else "stopped after SIGTERM")
        print(f"[cgpu] job {job['id']} {how} (exit={status['rc']})")
    elif gone:
        print(f"[cgpu] job {job['id']}: process group {pid} is gone; it left no exit status")
    elif kind == "lost":
        print(f"[cgpu] job {job['id']}: sent SIGKILL; a lost job leaves no exit status")
    else:
        die(f"SIGKILL sent to process group {pid}, but no final status appeared; "
            f"inspect `cgpu logs {a.session}`", 3)


def cmd_pull(a):
    local = Path(a.local).expanduser()
    # A file goes into LOCAL when LOCAL is a directory or is spelled like one.
    into = local.is_dir() or a.local.endswith(("/", os.sep))
    dest = local / PurePosixPath(a.remote).name if into else local
    dest.parent.mkdir(parents=True, exist_ok=True)
    # Download beside the destination and rename, so an interrupted pull never
    # leaves (or overwrites a good copy with) half a checkpoint.
    part = dest.parent / f".{dest.name}.cgpu-{uuid.uuid4().hex[:8]}.part"
    try:
        err = download(a.session, a.remote, part)
        if err is None:
            os.replace(part, dest)
            print(f"[cgpu] {a.remote} -> {dest}")
            return
    finally:
        part.unlink(missing_ok=True)
    if err == "missing":
        die(f"{a.remote} does not exist on '{a.session}'")
    # A directory: tar it on the VM, which needs an idle kernel.
    require_idle(a.session, f"pulling directory {a.remote}")
    tgz = f"/tmp/cgpu-pull-{uuid.uuid4().hex[:8]}.tgz"
    exec_py(a.session, f"import os,tarfile\n"
            f"with tarfile.open({tgz!r},'w:gz') as t: t.add({a.remote!r},arcname='.')\n"
            f"print('packed', os.path.getsize({tgz!r})//10**6, 'MB')")
    with tempfile.TemporaryDirectory() as d:
        colab("download", "-s", a.session, tgz, f"{d}/pull.tgz", capture=True)
        local.mkdir(parents=True, exist_ok=True)
        with tarfile.open(f"{d}/pull.tgz") as t:
            t.extractall(local, filter="data")
    colab("rm", "-s", a.session, tgz, capture=True, check=False)
    print(f"[cgpu] {a.remote} -> {local}")


def cmd_sh(a):
    if not a.cmd:
        die("usage: cgpu sh SESSION [--timeout SECS] -- CMD [ARGS...]")
    # A child's raw stdout bypasses the kernel's iopub stream, so capture it.
    sys.exit(exec_py(a.session, "import subprocess\ntry:\n    r = subprocess.run("
                     f"{list(a.cmd)!r}, capture_output=True, text=True)\n"
                     "except OSError as e:\n    print(e)\n    _cgpu_rc = 127\n"
                     "else:\n    print(r.stdout + r.stderr, end='')\n"
                     "    _cgpu_rc = r.returncode",
                     timeout=str(a.timeout), check=False))


def cmd_down(a):
    lock = session_lock(a.session)  # noqa: F841 (held until exit)
    colab("stop", "-s", a.session)
    job_file(a.session).unlink(missing_ok=True)
    colab("usage")


def cmd_ls(a):
    colab("sessions")
    colab("usage")


def main():
    p = argparse.ArgumentParser(prog="cgpu", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="c", required=True)
    s = sub.add_parser("up"); s.add_argument("session"); s.add_argument("gpu")
    s.add_argument("--high-mem", action="store_true"); s.set_defaults(f=cmd_up)
    s = sub.add_parser("push"); s.add_argument("session"); s.add_argument("local")
    s.add_argument("remote", nargs="?"); s.set_defaults(f=cmd_push)
    s = sub.add_parser("secrets"); s.add_argument("session")
    s.add_argument("which", nargs="*"); s.set_defaults(f=cmd_secrets)
    s = sub.add_parser("setup"); s.add_argument("session")
    s.add_argument("--timeout", type=int, default=3600); s.set_defaults(f=cmd_setup)
    s = sub.add_parser("start"); s.add_argument("session")
    s.add_argument("--cwd", default="/content"); s.set_defaults(f=cmd_start)
    s = sub.add_parser("logs"); s.add_argument("session")
    s.add_argument("-n", type=int, default=40)
    s.add_argument("--full", action="store_true", help="read the whole log, not its tail")
    s.set_defaults(f=cmd_logs)
    s = sub.add_parser("wait"); s.add_argument("session")
    s.add_argument("--poll", type=int, default=60)
    s.add_argument("--timeout", type=int, default=0,
                   help="give up after SECS (exit 124); the job keeps running")
    s.set_defaults(f=cmd_wait)
    s = sub.add_parser("kill"); s.add_argument("session"); s.set_defaults(f=cmd_kill)
    s = sub.add_parser("pull"); s.add_argument("session"); s.add_argument("remote")
    s.add_argument("local"); s.set_defaults(f=cmd_pull)
    s = sub.add_parser("sh"); s.add_argument("session")
    s.add_argument("--timeout", type=int, default=600); s.set_defaults(f=cmd_sh)
    s = sub.add_parser("down"); s.add_argument("session"); s.set_defaults(f=cmd_down)
    s = sub.add_parser("ls"); s.set_defaults(f=cmd_ls)
    argv = sys.argv[1:]
    cmd = []
    if "--" in argv:  # everything after `--` is the remote command, verbatim
        i = argv.index("--")
        argv, cmd = argv[:i], argv[i + 1:]
    a = p.parse_args(argv)
    a.cmd = cmd
    a.f(a)


if __name__ == "__main__":
    main()
